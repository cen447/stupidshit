#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${SCRIPT_DIR}/.venv"
BOT_PATH="${SCRIPT_DIR}/quote_smoke_bot.py"

if [[ "${1:-}" != "asad" ]]; then
  echo "Usage: fuck asad <runs>"
  exit 1
fi

RUNS="${2:-1}"
if ! [[ "$RUNS" =~ ^[0-9]+$ ]] || [[ "$RUNS" -lt 1 ]]; then
  echo "runs must be a positive integer"
  exit 1
fi

if [[ ! -d "$VENV_DIR" ]]; then
  echo ".venv not found at ${VENV_DIR}. Create it first:"
  echo "python3 -m venv \"$VENV_DIR\" && source \"$VENV_DIR/bin/activate\" && pip install -r \"$SCRIPT_DIR/requirements.txt\""
  exit 1
fi

source "$VENV_DIR/bin/activate"

BOT_CMD=(
  python -u "$BOT_PATH"
  --runs "$RUNS"
  --concurrency 1
  --progress-every 1
  --run-retries 0
  --checkpoint-grace-ms 10000
  --ready-timeout-ms 30000
)

if [[ -t 1 ]]; then
  echo "Launching smoke run (runs=$RUNS, concurrency=1, strict mode)."
  TMP_LOG="$(mktemp)"
  "${BOT_CMD[@]}" >"$TMP_LOG" 2>&1 &
  BOT_PID=$!

  GREEN='\033[0;32m'
  DIM='\033[2;32m'
  RESET='\033[0m'
  WIDE=60
  FIG_COL=52
  FRAME_LINES=13
  DRAWN=0

  hide_cursor() { tput civis 2>/dev/null || true; }
  show_cursor() { tput cnorm 2>/dev/null || true; }
  cleanup_tty() { show_cursor; }
  trap cleanup_tty EXIT INT TERM

  make_frame() {
    local proj_data="$1"
    local fig_state="$2"
    local show_stars="$3"

    local row
    local rows=()
    for ((row=0; row<5; row++)); do
      rows+=("$(printf '%*s' "$WIDE" '')")
    done
    rows+=("$(printf '%60s' '' | tr ' ' '─')")
    rows+=("$(printf '%*s' "$WIDE" '')")
    rows+=("$(printf '%*s' "$WIDE" '')")

    local f0 f1 f2
    case "$fig_state" in
      stand)  f0='  O  '; f1=' /|\ '; f2=' / \ ' ;;
      wobble) f0='  O  '; f1='-/|  '; f2=' / \ ' ;;
      hit)    f0='  O/ '; f1=' /|  '; f2='/  \ ' ;;
      hit2)   f0=' \O  '; f1='  |/ '; f2=' /\  ' ;;
      fall1)  f0='      '; f1='O-/| '; f2='  |\  ' ;;
      fall2)  f0='      '; f1='      '; f2='O__/|\ ' ;;
      fallen) f0='      '; f1='      '; f2='_O/\__ ' ;;
    esac

    write_str() {
      local row_idx=$1 col=$2 str=$3
      local row_text="${rows[$row_idx]}"
      local before after
      if (( col < 0 )); then
        str="${str:$(( -col ))}"
        col=0
      fi
      local end=$(( col + ${#str} ))
      (( end > WIDE )) && str="${str:0:$(( WIDE - col ))}"
      before="${row_text:0:$col}"
      after="${row_text:$(( col + ${#str} ))}"
      rows[$row_idx]="${before}${str}${after}"
    }

    write_str 0 $(( FIG_COL + 1 )) "Asad"
    write_str 1 $(( FIG_COL + 2 )) "^"
    write_str 2 "$FIG_COL" "$f0"
    write_str 3 "$FIG_COL" "$f1"
    write_str 4 "$FIG_COL" "$f2"

    if [[ "$show_stars" == "1" ]]; then
      write_str 1 $(( FIG_COL + 1 )) "  *  "
      write_str 2 $(( FIG_COL + 1 )) " *** "
      write_str 3 $(( FIG_COL + 1 )) "  *  "
    fi

    local entry pcol prow
    for entry in $proj_data; do
      pcol="${entry%%:*}"
      prow="${entry##*:}"
      if (( pcol < WIDE && pcol > -4 )); then
        write_str "$prow" "$pcol" "8==D"
      fi
    done

    printf "${GREEN}"
    printf "%s\n" "${rows[@]}"
    printf "${RESET}"
  }

  print_header() {
    printf "${DIM}  %-58s${RESET}\n" "// launching hawai lullay //"
    printf "${DIM}  %-58s${RESET}\n" ""
  }

  print_status() {
    local msg="$1"
    printf "${DIM}  %-58s${RESET}\n" "$msg"
  }

  draw_frame() {
    local proj_data="$1"
    local fig_state="$2"
    local show_stars="$3"
    local status_msg="$4"
    if (( DRAWN == 1 )); then
      printf "\033[%dA" "$FRAME_LINES"
    fi
    printf "\n"
    print_header
    make_frame "$proj_data" "$fig_state" "$show_stars"
    printf "\n"
    print_status "$status_msg"
    DRAWN=1
  }

  clear_frame_block() {
    (( DRAWN == 0 )) && return
    printf "\033[%dA" "$FRAME_LINES"
    for ((row=0; row<FRAME_LINES; row++)); do
      printf "\033[K\n"
    done
    printf "\033[%dA" "$FRAME_LINES"
  }

  run_animation_cycle() {
    local p0_col=0   p0_row=3 p0_speed=6
    local p1_col=-18 p1_row=2 p1_speed=5
    local p2_col=-30 p2_row=4 p2_speed=7
    local p3_col=-10 p3_row=1 p3_speed=4
    local fig="stand"
    local steps=14

    local t proj_data st near pc
    for ((t=0; t<steps; t++)); do
      kill -0 "$BOT_PID" 2>/dev/null || return 1
      proj_data="${p0_col}:${p0_row} ${p1_col}:${p1_row} ${p2_col}:${p2_row} ${p3_col}:${p3_row}"
      st="incoming..."
      near=0
      for pc in $p0_col $p1_col $p2_col $p3_col; do
        (( pc >= 46 && pc <= 54 )) && near=1
      done
      (( near == 1 )) && { fig="wobble"; st="oh no..."; }

      draw_frame "$proj_data" "$fig" "0" "$st"
      sleep 0.085

      p0_col=$(( p0_col + p0_speed ))
      p1_col=$(( p1_col + p1_speed ))
      p2_col=$(( p2_col + p2_speed ))
      p3_col=$(( p3_col + p3_speed ))
    done

    local state
    for state in hit hit2 hit hit2; do
      kill -0 "$BOT_PID" 2>/dev/null || return 1
      draw_frame "" "$state" "1" "sending hawai lullay"
      sleep 0.15
    done

    kill -0 "$BOT_PID" 2>/dev/null || return 1
    draw_frame "" "fall1" "0" "ooooooof..."
    sleep 0.20

    kill -0 "$BOT_PID" 2>/dev/null || return 1
    draw_frame "" "fall2" "0" "oooooooooof..."
    sleep 0.22

    local i
    for ((i=0; i<4; i++)); do
      kill -0 "$BOT_PID" 2>/dev/null || return 1
      draw_frame "" "fallen" "0" "x_x  ...rebooting dignity..."
      sleep 0.28
    done

    kill -0 "$BOT_PID" 2>/dev/null || return 1
    draw_frame "" "fallen" "0" "// TODO: teach Asad to dodge //"
    sleep 1
  }

  hide_cursor
  printf '\n%.0s' {1..13}
  while kill -0 "$BOT_PID" 2>/dev/null; do
    run_animation_cycle || break
  done

  wait "$BOT_PID"
  STATUS=$?
  clear_frame_block
  cat "$TMP_LOG"
  rm -f "$TMP_LOG"
  exit "$STATUS"
fi

"${BOT_CMD[@]}"
